{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-drafts",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_SHOW_DRAFTS=1",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "brand-mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4310",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design/brand-book"
      ],
      "port": 4310
    }
  ]
}